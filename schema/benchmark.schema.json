{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://insurance.local/schema/benchmark.schema.json",
  "title": "保额保费基准 v1",
  "description": "同一投保条件下的市场保费抽样集合。本 schema 输出的是「价格区间」，不是产品优劣排序 —— 每个样本只贡献一个保费数字和它的出处，任何 ranking / score / recommendation 字段都无法表达。",

  "type": "object",
  "additionalProperties": false,
  "required": ["id", "condition", "samples", "source"],
  "additionalPropertiesNote": "additionalProperties:false 是刻意的，见 docs/01-合规边界.md §2",

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bm-[a-z0-9-]{2,}$",
      "description": "例 bm-f0-50w-life-30p-consumption"
    },
    "label": {
      "type": "string",
      "description": "人话描述这一组条件，如「0岁女宝 / 50万 / 保终身 / 30年缴 / 消费型」"
    },

    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ageFrom", "ageTo", "gender", "sumInsured", "coverageTerm", "payTerm", "productType"],
      "description": "样本必须全部满足这组条件，否则不能放进同一组 —— 混了条件的区间没有意义",
      "properties": {
        "ageFrom": { "type": "integer", "minimum": 0 },
        "ageTo": { "type": "integer", "minimum": 0 },
        "gender": { "enum": ["male", "female"] },
        "sumInsured": { "type": "number", "exclusiveMinimum": 0, "description": "保额（元）" },
        "coverageTerm": {
          "enum": ["term_N_years", "to_age_70", "lifetime"],
          "description": "保障期限。term_N_years 需配合 termYears"
        },
        "termYears": { "type": ["integer", "null"], "minimum": 1 },
        "payTerm": { "type": "integer", "minimum": 1, "description": "缴费年期" },
        "productType": {
          "enum": ["consumption", "savings", "bundle"],
          "description": "消费型（纯保障）/ 储蓄型（带返还或账户）/ 全能险（打包）。这一栏是判断价格是否合理的前置条件 —— 同样是 50 万保额，消费型与储蓄型可以差 5 倍"
        },
        "hasDeathBenefit": { "type": ["boolean", "null"], "description": "是否含身故责任。少儿重疾含身故会贵 30-50%" },
        "hasMultipleClaim": { "type": ["boolean", "null"], "description": "是否含重疾多次赔付" },
        "childDiseaseExtraPct": { "type": ["number", "null"], "description": "少儿特定疾病额外赔比例，如 100 表示额外赔 100% 保额" }
      }
    },

    "samples": {
      "type": "array",
      "minItems": 1,
      "description": "保费样本。每个样本必须能追到该产品的官方费率表。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productName", "insurerName", "annualPremium", "source"],
        "properties": {
          "productName": { "type": "string", "minLength": 4 },
          "insurerName": { "type": "string", "minLength": 2 },
          "annualPremium": { "type": "number", "minimum": 0, "description": "年交保费（元）" },
          "isInLibrary": {
            "type": "boolean",
            "default": false,
            "description": "该产品是否也已收录进 data/products/"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verifiedAt", "verifier", "documents", "premiumQuote"],
            "properties": {
              "verifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "verifier": { "type": "string", "minLength": 1 },
              "documents": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "title", "url", "sha256", "fetchedAt", "tier"],
                  "properties": {
                    "type": { "enum": ["rate_table", "clause", "product_brochure", "screenshot", "filing"] },
                    "title": { "type": "string" },
                    "url": { "type": "string", "format": "uri" },
                    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "fetchedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                    "tier": { "enum": [1, 2, 3] }
                  }
                }
              },
              "premiumQuote": {
                "type": "string",
                "minLength": 4,
                "description": "费率表里对应这个保费的原文片段。保费是最容易被销售报错的字段，必须留痕。"
              }
            }
          }
        }
      }
    },

    "caveats": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "这组样本的使用限制。必须写清样本量小、渠道差异、费率表版本等会显著影响区间的地方。"
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiedAt", "verifier", "scopeNote"],
      "properties": {
        "verifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "verifier": { "type": "string", "minLength": 1 },
        "scopeNote": {
          "type": "string",
          "minLength": 4,
          "description": "样本是怎么选的：来自哪个平台、什么时间范围、有没有渠道限制。样本量小就必须写明。"
        }
      }
    }
  }
}